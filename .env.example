# =============================================================================
# NovelBuilder — Simplified .env
# 請複製此檔案並重新命名為 `.env` 放置於專案根目錄
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Generation Model / 文本生成模型設定
# -----------------------------------------------------------------------------
# 是否使用 Mock LLM (若要接真實 API 請保持 false)
NOVEL_BUILDER_USE_MOCK_LLM=false

NOVEL_BUILDER_LLM_PROVIDER=openai-compatible
NOVEL_BUILDER_OPENAI_API_KEY=your_generation_api_key_here
NOVEL_BUILDER_OPENAI_BASE_URL=https://api.openai.com/v1
NOVEL_BUILDER_LLM_MODEL=gpt-4o-mini

# invoke_json: OpenAI-style response_format json_object (部分相容 API 可改 false)
NOVEL_BUILDER_LLM_JSON_RESPONSE_FORMAT=true
# 初始結構化輸出失敗後，最多額外發起幾次 JSON repair 請求
NOVEL_BUILDER_LLM_JSON_REPAIR_ATTEMPTS=2
# 第 2 次起的 repair 省略 response_format，只靠 prompt 約束 JSON
NOVEL_BUILDER_LLM_JSON_REPAIR_PLAIN_ON_RETRY=false

# Macro compile：主線 slot-fill 完成後，支線錨點填槽並行呼叫 LLM 的最大 worker 數（1 = 完全串行；建議 2～3，須留意 API 並發與限速）
NOVEL_BUILDER_SIDE_SLOT_FILL_MAX_WORKERS=3

# -----------------------------------------------------------------------------
# 2. Embedding Model / 向量嵌入模型設定 (獨立設定區塊)
# -----------------------------------------------------------------------------
# Embedding 專用連線設定 (若與生成模型不同平台，請填寫此區)
NOVEL_BUILDER_EMBEDDING_PROVIDER=openai-compatible
NOVEL_BUILDER_EMBEDDING_API_KEY=your_embedding_api_key_here
NOVEL_BUILDER_EMBEDDING_BASE_URL=https://api.openai.com/v1

# Embedding 模型名稱與對應的向量維度
NOVEL_BUILDER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NOVEL_BUILDER_QDRANT_VECTOR_SIZE=1536

# -----------------------------------------------------------------------------
# 3. Database & Services / 資料庫與 Docker 服務設定
# -----------------------------------------------------------------------------
# 是否使用記憶體模式 (false 代表需要連線到下方設定的實體資料庫)
NOVEL_BUILDER_USE_IN_MEMORY_STORES=false

# Neo4j 圖形資料庫設定 (對應 docker-compose 服務)
NOVEL_BUILDER_NEO4J_URI=bolt://neo4j:7687
NOVEL_BUILDER_NEO4J_USERNAME=neo4j
NOVEL_BUILDER_NEO4J_PASSWORD=novelbuilder

# Qdrant 向量資料庫設定 (對應 docker-compose 服務)
NOVEL_BUILDER_QDRANT_URL=http://qdrant:6333