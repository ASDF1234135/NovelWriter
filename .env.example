# =============================================================================
# NovelBuilder — sample .env (bilingual: EN / 繁中)
# Copy to `.env` at repo root. Omitted keys → defaults in backend/app/core/config.py
# 複製為專案根目錄 `.env`；未列出變數沿用 config 預設值。
# =============================================================================

# -----------------------------------------------------------------------------
# Cloud LLM — required when using a real API / 雲端 LLM（接真實 API 時必填）
# -----------------------------------------------------------------------------
NOVEL_BUILDER_USE_MOCK_LLM=false
NOVEL_BUILDER_LLM_PROVIDER=openai-compatible
NOVEL_BUILDER_OPENAI_API_KEY=
NOVEL_BUILDER_OPENAI_BASE_URL=https://api.openai.com/v1

# Default chat model for any agent without a per-role override below.
# 預設對話模型：凡未在下方細項單獨指定的 Agent，皆使用此模型。
NOVEL_BUILDER_LLM_MODEL=gpt-4o-mini

# Per-role model overrides (optional). Empty = use LLM_MODEL above.
# Priority: per-role > LLM_MODEL / 優先順序：細項 > LLM_MODEL
#   MACRO, DIRECTOR, PLANNER, SUPERVISOR, AUTHOR, READER
# Second Author pass (extraction surface hints): empty = SUPERVISOR_LLM_MODEL > LLM_MODEL
# Author 第二段（抽取用精確子字串）：空則沿用 SUPERVISOR > LLM_MODEL
# NOVEL_BUILDER_MACRO_LLM_MODEL=
# NOVEL_BUILDER_DIRECTOR_LLM_MODEL=
# NOVEL_BUILDER_PLANNER_LLM_MODEL=
# NOVEL_BUILDER_SUPERVISOR_LLM_MODEL=
# NOVEL_BUILDER_AUTHOR_LLM_MODEL=
# NOVEL_BUILDER_READER_LLM_MODEL=
# NOVEL_BUILDER_AUTHOR_HINTS_LLM_MODEL=
# NOVEL_BUILDER_AUTHOR_HINTS_TEMPERATURE=0.1

# HTTP timeout per request (seconds); increase for long author chapters.
# 請求逾時（秒）；長章 author 可酌增。
NOVEL_BUILDER_OPENAI_TIMEOUT_SECONDS=120

# Chat streaming (SSE): may reduce proxy/gateway idle timeouts; nodes still get full text.
# 對話串流：較早開始送 body，有時可減少閒置斷線；各節點仍收到完整內容。
# NOVEL_BUILDER_OPENAI_STREAM_CHAT=false
# JSON / response_format streaming (optional); falls back to non-stream on 4xx if unsupported.
# 結構化 JSON 串流（選用）；若 API 不支援會自動改回非串流。
# NOVEL_BUILDER_OPENAI_STREAM_STRUCTURED=false
# OpenAI-style stream_options.include_usage (disable if your provider errors on unknown fields).
# NOVEL_BUILDER_OPENAI_STREAM_INCLUDE_USAGE=false
# NOVEL_BUILDER_OPENAI_CONNECT_TIMEOUT_SECONDS=10
# Idle limit between stream chunks (seconds).
# 串流時兩個 chunk 之間的最長等待（秒）。
# NOVEL_BUILDER_OPENAI_STREAM_READ_TIMEOUT_SECONDS=300

# Chapter target words: Planner output is clamped; not tied to volume budgets.
# 章節目標字數：由 Planner 決定並截斷於此區間；與卷字數無硬性綁定。
# NOVEL_BUILDER_CHAPTER_WORD_MIN=800
# NOVEL_BUILDER_CHAPTER_WORD_MAX=12000
# NOVEL_BUILDER_DEFAULT_CHAPTER_WORDS=2500
# NOVEL_BUILDER_PLAN_SUPERVISOR_WORDS_PER_BEAT_FLOOR=200

# Temperature: code has defaults per role; override e.g. NOVEL_BUILDER_AUTHOR_TEMPERATURE=0.85
# There is no single global temperature env — only per-role *_TEMPERATURE keys.
# 溫度：程式依角色有預設；覆寫請用各角色變數（無全體單一溫度）。

# -----------------------------------------------------------------------------
# Embeddings + vector store — dimension must match the embedding model
# Embedding + 向量庫（維度須與模型一致）
# -----------------------------------------------------------------------------
NOVEL_BUILDER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NOVEL_BUILDER_QDRANT_VECTOR_SIZE=1536
# NOVEL_BUILDER_QDRANT_RECREATE_ON_DIMENSION_MISMATCH=true

# -----------------------------------------------------------------------------
# Persistence — when false, Neo4j + Qdrant must be reachable (e.g. docker compose)
# 儲存：false 時需連上 Neo4j / Qdrant
# -----------------------------------------------------------------------------
NOVEL_BUILDER_USE_IN_MEMORY_STORES=false
NOVEL_BUILDER_NEO4J_URI=bolt://neo4j:7687
NOVEL_BUILDER_NEO4J_USERNAME=neo4j
NOVEL_BUILDER_NEO4J_PASSWORD=novelbuilder
NOVEL_BUILDER_QDRANT_URL=http://qdrant:6333

# -----------------------------------------------------------------------------
# Common tuning / 常用調整
# -----------------------------------------------------------------------------
# Relation extraction: max entities per LLM batch (0 = one call, may time out).
# 章節抽取 relation 每批實體數（0 = 單次全量，易逾時）。
NOVEL_BUILDER_EXTRACTION_RELATION_ENTITY_BATCH_SIZE=10
# Post-reader prose polish (Traditional Chinese + light formatting) before DB write.
# 讀者通過後、入庫前繁體／格式輕修飾。
NOVEL_BUILDER_PROSE_POLISH_ENABLED=true

# -----------------------------------------------------------------------------
# Optional / 可選
# -----------------------------------------------------------------------------
NOVEL_BUILDER_SQLITE_PATH=./data/novelbuilder.sqlite3
NOVEL_BUILDER_CORS_ORIGINS=http://localhost:5173
