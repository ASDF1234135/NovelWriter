NOVEL_BUILDER_APP_NAME=NovelBuilder AI
NOVEL_BUILDER_ENV=development
NOVEL_BUILDER_API_PREFIX=/api
NOVEL_BUILDER_SQLITE_PATH=./data/novelbuilder.sqlite3
NOVEL_BUILDER_USE_IN_MEMORY_STORES=false
NOVEL_BUILDER_USE_MOCK_LLM=true
NOVEL_BUILDER_NEO4J_URI=bolt://neo4j:7687
NOVEL_BUILDER_NEO4J_USERNAME=neo4j
NOVEL_BUILDER_NEO4J_PASSWORD=novelbuilder
NOVEL_BUILDER_NEO4J_DATABASE=neo4j
NOVEL_BUILDER_QDRANT_URL=http://qdrant:6333
NOVEL_BUILDER_QDRANT_COLLECTION=story_chunks
NOVEL_BUILDER_QDRANT_VECTOR_SIZE=1536
NOVEL_BUILDER_QDRANT_RECREATE_ON_DIMENSION_MISMATCH=false
NOVEL_BUILDER_LLM_PROVIDER=openai-compatible
NOVEL_BUILDER_LLM_MODEL=gpt-4o-mini
NOVEL_BUILDER_MACRO_LLM_MODEL=
NOVEL_BUILDER_DIRECTOR_LLM_MODEL=
NOVEL_BUILDER_PLANNER_LLM_MODEL=
NOVEL_BUILDER_SUPERVISOR_LLM_MODEL=
NOVEL_BUILDER_AUTHOR_LLM_MODEL=
NOVEL_BUILDER_READER_LLM_MODEL=
NOVEL_BUILDER_MACRO_TEMPERATURE=0.25
NOVEL_BUILDER_DIRECTOR_TEMPERATURE=0.2
NOVEL_BUILDER_PLANNER_TEMPERATURE=0.35
NOVEL_BUILDER_SUPERVISOR_TEMPERATURE=0.1
NOVEL_BUILDER_AUTHOR_TEMPERATURE=0.85
NOVEL_BUILDER_READER_TEMPERATURE=0.3
NOVEL_BUILDER_OPENAI_BASE_URL=https://api.openai.com/v1
NOVEL_BUILDER_OPENAI_API_KEY=
NOVEL_BUILDER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NOVEL_BUILDER_OPENAI_TIMEOUT_SECONDS=120
# Split state_extractor: per-step chapter text budgets (chars)
NOVEL_BUILDER_EXTRACTION_ENTITY_TEXT_BUDGET=9000
NOVEL_BUILDER_EXTRACTION_MEMORY_FULL_TEXT_BUDGET=14000
NOVEL_BUILDER_EXTRACTION_RELATION_TEXT_BUDGET=8000
NOVEL_BUILDER_EXTRACTION_CANDIDATE_NODES_CAP=60
NOVEL_BUILDER_EXTRACTION_GRAPH_SUMMARY_MAX_CHARS=2500
# Relation step: entities per LLM call (0 = one call with all entities). Default 12 to limit prompt size.
NOVEL_BUILDER_EXTRACTION_RELATION_ENTITY_BATCH_SIZE=12
NOVEL_BUILDER_CORS_ORIGINS=http://localhost:5173
